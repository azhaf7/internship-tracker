# Copy this file to .env and fill in your own values.
# .env is gitignored - never commit real credentials.

# MongoDB Atlas connection string.
# Atlas -> Cluster -> Connect -> Drivers -> copy the string, then replace
# <db_password> with your database user's password.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/internship_tracker?retryWrites=true&w=majority

PORT=5050
CLIENT_ORIGIN=http://localhost:5173
